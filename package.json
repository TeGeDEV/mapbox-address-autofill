{
  "name": "@tegedev/mapbox-address-autofill",
  "version": "1.0.2",
  "description": "Custom Mapbox address autofill hooks",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
